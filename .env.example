# Supabase (Project Settings → API). Server-only: never prefix with NEXT_PUBLIC_.
# The anon / publishable key is enough: RLS allows insert-only on both tables.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Absolute site URL, used for sitemap, canonical and OG URLs.
NEXT_PUBLIC_SITE_URL=https://bonya.co.uk
